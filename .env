# Copy this file to .env before running docker-compose up

# Security
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (docker-compose default; change for cloud e.g. Neon)
DATABASE_URL=postgresql+asyncpg://chat_user:chat_pass@localhost:5432/chatdb

# Redis (docker-compose default; change for cloud e.g. Upstash)
# NOTE: for Upstash use the TCP connection string from the "TCP" tab
# (not the REST API URL), it looks like: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379/0

ENV=development
